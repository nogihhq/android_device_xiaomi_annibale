--- a/device/xiaomi/annibale/sepolicy/vendor
diff --git a/sepolicy/vendor/app.te b/sepolicy/vendor/app.te
index 7f27945..d51135d 100644
--- a/sepolicy/vendor/app.te
+++ b/sepolicy/vendor/app.te
@@ -1,4 +1,5 @@
 
 # Allow apps to read fingerprint & payment security props for Alipay/WeChat
-get_prop({ appdomain -isolated_app }, vendor_fp_prop)
-get_prop({ appdomain -isolated_app }, vendor_payment_security_prop)
+get_prop({ appdomain -isolated_app_all }, vendor_fp_prop)
+get_prop({ appdomain -isolated_app_all }, vendor_payment_security_prop)
+
diff --git a/sepolicy/vendor/platform_app.te b/sepolicy/vendor/platform_app.te
index 08f6a87..7c5ba63 100644
--- a/sepolicy/vendor/platform_app.te
+++ b/sepolicy/vendor/platform_app.te
@@ -2,3 +2,13 @@ allow platform_app_36 hal_postprocservice_service:service_manager find;
 allow platform_app_36 proc_pressure_cpu:file { getattr open read write };
 allow platform_app_36 proc_pressure_io:file { getattr open read write };
 allow platform_app_36 proc_pressure_mem:file { getattr open read write };
+
+# Soter Service for WeChat Pay
+hal_client_domain(platform_app, vendor_hal_soter)
+hal_client_domain(platform_app, hal_mlipay)
+allow platform_app hal_mlipay_service:service_manager find;
+
+# IFAA mlipay access for platform_app_36 (Android 17 / API 36)
+allow platform_app_36 hal_mlipay_service:service_manager find;
+hal_client_domain(platform_app_36, hal_mlipay)
+binder_call(platform_app_36, hal_mlipay_server)
diff --git a/sepolicy/vendor/system_app.te b/sepolicy/vendor/system_app.te
index dc97487..4543077 100644
--- a/sepolicy/vendor/system_app.te
+++ b/sepolicy/vendor/system_app.te
@@ -1 +1,6 @@
 binder_call(system_app, vendor_hal_displayfeature_xiaomi_default)
+
+# Soter Service for WeChat Pay
+hal_client_domain(system_app, vendor_hal_soter)
+hal_client_domain(system_app, hal_mlipay)
+allow system_app hal_mlipay_service:service_manager find;
