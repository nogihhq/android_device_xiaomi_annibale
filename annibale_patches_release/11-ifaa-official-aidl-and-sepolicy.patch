--- a/vendor/xiaomi/annibale/Android.bp
diff --git a/Android.bp b/Android.bp
index 254ae60..676d40e 100644
--- a/Android.bp
+++ b/Android.bp
@@ -49327,3 +49327,25 @@ filegroup {
         "proprietary/vendor/etc/qcril_database/upgrade/other/0015_version_add_iccid_clir_pref_table.sql",
     ],
 }
+
+android_app_import {
+    name: "SoterService",
+    owner: "xiaomi",
+    apk: "proprietary/product/app/SoterService/SoterService.apk",
