<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.miui.securitycenter">

    <application
        android:label="Security Center"
        android:allowBackup="false">

        <activity
            android:name="com.miui.securitycenter.CtaActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="miui.intent.action.SYSTEM_PERMISSION_DECLARE_NEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="miui.intent.action.SYSTEM_PERMISSION_DECLARE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="miui.intent.action.APP_PERMISSION_USE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>
</manifest>
