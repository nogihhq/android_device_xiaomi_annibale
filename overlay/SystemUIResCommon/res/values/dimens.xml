<resources>
    <!-- Microns/ums (1000 um = 1mm) per pixel for the given device. If unspecified, UI that
         relies on this value will not be sized correctly. -->
    <item name="pixel_pitch" format="float" type="dimen">50.0</item>

    <!-- the padding on the top of the statusbar (usually 0) -->
    <dimen name="status_bar_padding_top">6dp</dimen>

    <!-- the padding on the start of the statusbar -->
    <dimen name="status_bar_padding_start">7dp</dimen>

    <!-- the padding on the end of the statusbar -->
    <dimen name="status_bar_padding_end">2dp</dimen>

    <!-- Height of the status bar header bar when on Keyguard -->
    <dimen name="status_bar_header_height_keyguard">@*android:dimen/status_bar_height</dimen>

    <!-- 锁屏左边距（必须算，不能直接写 7dp）。
         KeyguardStatusBarView.updateCarrierLabelMargin() 用的是
             calculateMargin(keyguard_carrier_text_margin, mPadding.left)
         且 calculateMargin() 在 margin <= padding 时返回 0，所以锁屏实际左边距是
             max(mPadding.left, keyguard_carrier_text_margin)。
         mPadding.left 来自 StatusBarContentInsetsProvider：
             rounded_corner_content_padding = 74px（本机型 ro.sf.lcd_density=480，即 24.67dp）
         而解锁状态栏的左边距是 mPadding.left + status_bar_padding_start(7dp)。
         因此这里要取 74px + 7dp = 74 + 21 = 95px，
         锁屏才会和解锁状态栏的 7dp 对齐；只写 7dp 会被 74px 的地板吃掉，等于没设。 -->
    <dimen name="keyguard_carrier_text_margin">95px</dimen>

    <!-- Adjust the icon padding in status bar for rounded corners. -->
    <dimen name="rounded_corner_content_padding">74.0px</dimen>
</resources>
